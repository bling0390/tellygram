<?xml version="1.0" encoding="utf-8"?>
<!--
  Theme.Tellygram — base theme for the app.
  Compose for TV handles its own theming via tv-material; this XML
  theme is just the activity window backdrop during cold start.
-->
<resources>

    <style name="Theme.Tellygram" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
